#include <WiFi.h>
#include <esp_now.h>
#include "esp_bt.h"
#include "esp_wifi.h"

// ===== НАСТРОЙКА ПИНОВ КНОПОК =====
const int bsPins[] = {0, 3, 4};
const int bsCount = 3;

const int bssPins[] = {1, 5, 10};
const int bssCount = 3;

// ===== ПИНЫ ИНДИКАЦИИ =====
const int ledBS_Pin = 20;    // мигает при нажатии пина 0
const int ledBSS_Pin = 21;   // мигает при нажатии пина 1
unsigned long ledBS_Until = 0;
unsigned long ledBSS_Until = 0;

// ===== ESP-NOW =====
uint8_t broadcastMac[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

// ===== ЗАЩИТА =====
const unsigned long debounceDelay = 200;   // антидребезг
const unsigned long spamDelay = 1000;      // мин. пауза между отправками одного пина

// ===== СТРУКТУРА СОСТОЯНИЯ КНОПКИ =====
struct ButtonState {
  int pin;
  bool lastState;
  bool lastSentState;
  bool isStable;
  unsigned long lastChangeTime;
  unsigned long lastSendTime;
  unsigned long pressStartTime;    // время начала нажатия
  bool isPressed;                 // флаг что кнопка зажата
  bool longPressSent;            // флаг что длинное нажатие уже отправлено
   unsigned long releaseTime;      // время последнего отпускания
  bool wasPressed;               // флаг что кнопка была нажата
  bool conditionMet;            // флаг что условие выполнено
};

ButtonState bsStates[bsCount];
ButtonState bssStates[bssCount];

// ===== ОТПРАВКА С АНТИСПАМОМ, ДЕДУПЛИКАЦИЕЙ И ЗАПУСКОМ ИНДИКАЦИИ =====
bool sendEvent(const String& prefix, int pin, int state, ButtonState& btn) {
  // === ДЕДУПЛИКАЦИЯ ===
  if (btn.lastSentState == state) return false;
  
  // === АНТИСПАМ ===
  unsigned long now = millis();
  if (now - btn.lastSendTime < spamDelay) return false;
  
  // === ФОРМИРОВАНИЕ ПАКЕТА ===
  String msg = prefix + "_" + String(pin) + "_" + String(state);
  
  uint8_t dataBuf[16];
  msg.getBytes(dataBuf, msg.length() + 1);
  esp_now_send(broadcastMac, dataBuf, msg.length());
  
  // === ЗАПУСК МИГАНИЯ (только для коротких нажатий) ===
  if (state == 1) {  // короткое нажатие
    if (pin == 0) ledBS_Until = millis() + 2000;
    if (pin == 1) ledBSS_Until = millis() + 2000;
  }
  
  // === ОБНОВЛЕНИЕ ===
  btn.lastSentState = state;
  btn.lastSendTime = now;
  
  Serial.print("📤 ");
  Serial.println(msg);
  return true;
}

// ===== ИНИЦИАЛИЗАЦИЯ МАССИВА КНОПОК =====
void initButtonStates(ButtonState states[], const int pins[], int count) {
  for (int i = 0; i < count; i++) {
    states[i].pin = pins[i];
    states[i].lastState = digitalRead(pins[i]);
    states[i].lastSentState = HIGH;        // кнопка отпущена (INPUT_PULLUP)
    states[i].isStable = true;
    states[i].lastChangeTime = 0;
    states[i].lastSendTime = 0;
      states[i].pressStartTime = 0;
    states[i].isPressed = false;
    states[i].longPressSent = false;
      states[i].releaseTime = 0;
    states[i].wasPressed = false;
    states[i].conditionMet = false;
  }
}
// Проверяет, нажат ли связанный пин (4 для пина 3, 10 для пина 5)
bool isLinkedPinPressed(int pin) {
  if (pin == 3) {
    return digitalRead(4) == LOW;  // LOW = нажат (INPUT_PULLUP)
  } else if (pin == 5) {
    return digitalRead(10) == LOW; // LOW = нажат (INPUT_PULLUP)
  }
  return false;
}

// ===== ОПРОС ГРУППЫ КНОПОК (единая логика для всех пинов) =====
void scanGroup(ButtonState states[], int count, const String& prefix) {
  unsigned long currentTime = millis();
  
  for (int i = 0; i < count; i++) {
    int pin = states[i].pin;
    bool currentState = digitalRead(pin);
    
    // === ОБРАБОТКА ИЗМЕНЕНИЙ СОСТОЯНИЯ ===
    if (currentState != states[i].lastState) {
      states[i].lastChangeTime = currentTime;
      states[i].isStable = false;
      states[i].lastState = currentState;
      
      // Если кнопка НАЖАТА (LOW)
      if (currentState == LOW) {
        states[i].pressStartTime = currentTime;
        states[i].isPressed = true;
        states[i].longPressSent = false;
        states[i].wasPressed = true;
        Serial.printf("🔽 Пин %d нажат\n", pin);
      }
      // Если кнопка ОТПУЩЕНА (HIGH)
      else {
        states[i].isPressed = false;
        states[i].longPressSent = false;
        states[i].releaseTime = currentTime;
        Serial.printf("🔼 Пин %d отпущен\n", pin);
      }
    }
    
    // === ЛОГИКА ДЛИННОГО НАЖАТИЯ (пины 0 и 1) ===
    if ((pin == 0 || pin == 1) && states[i].isPressed && !states[i].longPressSent) {
      unsigned long pressDuration = currentTime - states[i].pressStartTime;
      
      if (pressDuration >= 4000) {
        states[i].longPressSent = true;
        int eventState = 2;
        sendEvent(prefix, pin, eventState, states[i]);
        Serial.printf("🔴 ДЛИННОЕ нажатие пина %d (%d мс)\n", pin, pressDuration);
      }
    }
    
    // === ЛОГИКА ДЛЯ ПИНОВ 3 И 5 ===
    if ((pin == 3 || pin == 5) && states[i].isPressed && !states[i].conditionMet) {
      unsigned long pressDuration = currentTime - states[i].pressStartTime;
      
      bool conditionA = (pressDuration >= 3000);
      
      bool conditionB = false;
      if (states[i].releaseTime > 0) {
        unsigned long pauseDuration = states[i].pressStartTime - states[i].releaseTime;
        conditionB = (pauseDuration >= 5000);
      } else {
        conditionB = true;
      }
      
      bool conditionC = !isLinkedPinPressed(pin);
      
      if (conditionA && conditionB && conditionC) {
        states[i].conditionMet = true;
        int eventState = 1;
        sendEvent(prefix, pin, eventState, states[i]);
        Serial.printf("✅ УСЛОВИЕ ВЫПОЛНЕНО для пина %d (длит:%dмс, пауза:%dмс, связ.пин:%s)\n", 
          pin, pressDuration, 
          (states[i].releaseTime > 0 ? states[i].pressStartTime - states[i].releaseTime : 0),
          conditionC ? "свободен" : "занят");
      }
    }
    
    // === СТАНДАРТНАЯ ОБРАБОТКА СТАБИЛЬНОГО СОСТОЯНИЯ ===
    if (!states[i].isStable && (currentTime - states[i].lastChangeTime) >= debounceDelay) {
      states[i].isStable = true;
      
      // === ДЛЯ ПИНОВ 4 И 10: ТОЛЬКО НАЖАТИЕ (фронт) ===
      if (pin == 4 || pin == 10) {
        // Отправляем только если кнопка НАЖАТА (LOW)
        if (currentState == LOW) {
          // Проверяем что нажатие было дольше 200мс (антидребезг уже есть, но добавим проверку)
          unsigned long pressDuration = currentTime - states[i].pressStartTime;
          if (pressDuration >= 200) {
            int eventState = 1;  // 1 = нажата
            sendEvent(prefix, pin, eventState, states[i]);
            Serial.printf("✅ НАЖАТИЕ пина %d (длит:%d мс)\n", pin, pressDuration);
          }
        }
        // При отпускании НИЧЕГО не отправляем
        // (просто игнорируем состояние HIGH)
      }
      
      // === ДЛЯ ПИНОВ 0 И 1: КОРОТКОЕ НАЖАТИЕ ===
      else if (pin == 0 || pin == 1) {
        if (currentState == HIGH) {  // отпущена
          unsigned long pressDuration = currentTime - states[i].pressStartTime;
          if (pressDuration < 1000 && pressDuration > 50) {
            int eventState = 1;
            sendEvent(prefix, pin, eventState, states[i]);
            Serial.printf("✅ КОРОТКОЕ нажатие пина %d (%d мс)\n", pin, pressDuration);
          }
        }
      }
      
      // === ДЛЯ ПИНОВ 3 И 5: СБРОС ФЛАГОВ ПРИ ОТПУСКАНИИ ===
      else if (pin == 3 || pin == 5) {
        if (currentState == HIGH) {
          states[i].conditionMet = false;
          // НЕ отправляем состояние "отпущено"
        }
      }
      
      // === ДЛЯ ОСТАЛЬНЫХ ПИНОВ (если есть) ===
      else {
        int eventState = (currentState == LOW) ? 1 : 0;
        sendEvent(prefix, pin, eventState, states[i]);
      }
    }
  }
}

// ===== УПРАВЛЕНИЕ ИНДИКАЦИЕЙ (МИГАНИЕ) =====
void updateLeds() {
  unsigned long now = millis();
  
  // Пин 20 — мигает пока ledBS_Until > now
  if (ledBS_Until > now) {
    bool on = (now / 200) % 2;  // период 200мс
    digitalWrite(ledBS_Pin, on ? HIGH : LOW);
  } else {
    digitalWrite(ledBS_Pin, LOW);
  }
  
  // Пин 21 — мигает пока ledBSS_Until > now
  if (ledBSS_Until > now) {
    bool on = (now / 200) % 2;
    digitalWrite(ledBSS_Pin, on ? HIGH : LOW);
  } else {
    digitalWrite(ledBSS_Pin, LOW);
  }
}

// ===== SETUP =====
void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("=== NODA BOOT ===");
  
  // === WiFi/ESP-NOW — ИДЕНТИЧНО ШКАФУ ===
  esp_bt_controller_disable();

  // Настройка пинов кнопок
  for (int i = 0; i < bsCount; i++) {
    pinMode(bsPins[i], INPUT_PULLUP);
  }
  for (int i = 0; i < bssCount; i++) {
    pinMode(bssPins[i], INPUT_PULLUP);
  }
  
  // === Пины индикации как выходы ===
  pinMode(ledBS_Pin, OUTPUT);
  digitalWrite(ledBS_Pin, LOW);
  pinMode(ledBSS_Pin, OUTPUT);
  digitalWrite(ledBSS_Pin, LOW);
  
  // Инициализация состояний кнопок
  initButtonStates(bsStates, bsPins, bsCount);
  initButtonStates(bssStates, bssPins, bssCount);
  
  // === WiFi и ESP-NOW ===
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  WiFi.setSleep(false);
  esp_wifi_set_max_tx_power(127);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);
  
  if (esp_now_init() != ESP_OK) {
    Serial.println("❌ esp_now_init FAILED");
    return;
  }
  Serial.println("✓ esp_now_init OK");

  esp_now_peer_info_t peerInfo;
  memset(&peerInfo, 0, sizeof(peerInfo));
  memcpy(peerInfo.peer_addr, broadcastMac, 6);
  peerInfo.channel = 1;
  peerInfo.encrypt = false;
  esp_now_add_peer(&peerInfo);
  Serial.println("✓ peer OK");

  WiFi.setTxPower(WIFI_POWER_8_5dBm);
  
  Serial.println("BS: 0, 3, 4 | BSS: 1, 5, 10");
  Serial.println("Индикация: GPIO 20 (BS_0), GPIO 21 (BSS_1) — мигают 2с");
  Serial.println("=== NODA READY ===");
}

// ===== LOOP =====
void loop() {
  // Опрос кнопок (единая логика)
  scanGroup(bsStates, bsCount, "BS");
  scanGroup(bssStates, bssCount, "BSS");
  
  // Управление миганием
  updateLeds();
  
  delay(10);
}
